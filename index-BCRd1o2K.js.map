
// ═══════════════════════════════════════════════════════════════════
//  _overlay.wgsl — Pełnoekranowa nakładka HUD / Winieta / Dziurka od klucza
// ═══════════════════════════════════════════════════════════════════

struct Uniforms {
  mouse: vec4f,              // 0..16
  resolution: vec2f,         // 16..24
  time: f32,                 // 24..28
  dt: f32,                   // 28..32
  numPoints: u32,            // 32..36
  gravity: f32,              // 36..40
  damping: f32,              // 40..44
  interactionRadius: f32,    // 44..48
  vortexStrength: f32,       // 48..52
  pointSizeMultiplier: f32,  // 52..56
  interactionMode: f32,      // 56..60
  glowIntensity: f32,        // 60..64
  renderScale: f32,          // 64..68
  showOverlay: f32,          // 68..72
  pad0: f32,                 // 72..76
  pad1: f32,                 // 76..80
};

@group(0) @binding(0) var<uniform> U: Uniforms;

struct VertexOutput {
  @builtin(position) clipPos: vec4f,
  @location(0) uv: vec2f,
  @location(1) color: vec4f,
  @location(2) speed: f32,
  @location(3) vDistance: f32
};

// ═══════════════════════════════════════════════════════════════════
// VERTEX SHADER — Generuje pełnoekranowy trójkąt bez użycia bufora
// ═══════════════════════════════════════════════════════════════════
@vertex
fn vs_overlay(@builtin(vertex_index) vertexIndex: u32) -> VertexOutput {
  var out: VertexOutput;

  // Współrzędne jednego dużego trójkąta pokrywającego cały ekran w NDC:
  var pos = array<vec2f, 3>(
    vec2f(-1.0, -1.0),
    vec2f( 3.0, -1.0),
    vec2f(-1.0,  3.0)
  );

  let p = pos[vertexIndex];
  out.clipPos = vec4f(p, 0.0, 1.0);
  out.uv = p; // Zakres [-1.0, 1.0]
  out.color = vec4f(1.0, 1.0, 1.0, 1.0);
  out.speed = 0.0;  

  return out;
}

// ═══════════════════════════════════════════════════════════════════
// FRAGMENT SHADER — Maska "zygi jednorozca, abominacja i nie tylko tego, patrzenie grozi slepota albo przynajmniej tmczasową utrata poczytalnosci slepota to twoje najmniejsze zmartwienie, bo w tym samym czasie twoje oczy zostaną zjedzone przez kosmitów, a ty zostaniesz zmuszony do oglądania ich w pełnej okazałości, co może spowodować trwałe uszkodzenie wzroku i psychiki, a także wywołać niekontrolowane drgawki i halucynacje, które mogą prowadzić do śmierci lub utraty przytomności, dlatego zaleca się noszenie specjalnych okularów ochronnych i unikanie bezpośredniego kontaktu wzrokowego z tymi istotami, a także zachowanie dystansu i ostrożności podczas obserwacji ich działań i zachowań, aby uniknąć niebezpieczeństwa i ryzyka dla zdrowia i życia, a także zapewnić sobie bezpieczeństwo i ochronę przed potencjalnymi zagrożeniami i niebezpieczeństwami związanymi z kontaktem z tymi istotami, które mogą być agresywne i nieprzewidywalne w swoim zachowaniu i reakcjach na bodźce zewnętrzne, co może prowadzić do poważnych konsekwencji dla osób narażonych na ich obecność i działanie, dlatego należy zachować szczególną ostrożność i rozwagę podczas interakcji z tymi istotami oraz stosować się do zaleceń ekspertów i specjalistów w dziedzinie bezpieczeństwa i ochrony przed zagrożeniami związanymi z kontaktem z obcymi formami życia zmnaczy stylu bycia. <clown emoji:  > jesli czytasz to znaczy ze juz nie masz oczu i nie wiesz co sie dzieje, ale to nie jest problem bo i tak juz nie zyjesz, wiec gratulacje, udalo ci sie przetrwac do tego momentu, ale teraz musisz zmierzyc sie z konsekwencjami swoich dzialan i wyborow, ktore doprowadzily cie do tej sytuacji, a teraz musisz podjac decyzje czy chcesz walczyc o swoje zycie i zdrowie psychiczne, czy tez poddasz sie i pozwolisz tym istotom zdominowac twoja egzystencje i zniszczyc wszystko co kiedys bylo dla ciebie wazne i cenne, dlatego musisz byc silny i odwazny, aby przetrwac w tym brutalnym i nieprzewidywalnym swiecie, gdzie kazdy blad moze kosztowac cie zycie lub zdrowie psychiczne, a kazda decyzja moze miec dalekosiężne konsekwencje dla twojej przyszlosci i losu calej ludzkości ludzkosci powtorz o 27 razy czy to dalej jest slowo? OoO"
// ═══════════════════════════════════════════════════════════════════
@fragment
fn fs_overlay(in: VertexOutput) -> @location(0) vec4f {
  // Jeśli nakładka HUD jest ukryta, zwracamy 0 alpha (widzimy 100% czystą symulację w tle)
  if (U.showOverlay < 0.5) {
    return vec4f(0.0);
  }

  // ───────────────────────────────────────────────────────────────
  // 1. WSPÓŁRZĘDNE EKRANU I OBRÓT (np. 90° / -90° przy pochyleniu telefonu)
  // ───────────────────────────────────────────────────────────────
  let aspect = U.resolution.x / max(1.0, U.resolution.y);
  var screenPos = vec2f(in.uv.x * aspect, in.uv.y);

  // Obrót nakładki wraz z obrotem kamery telefonu
  let rot = 0.0;
  if (abs(rot) > 0.0001) {
    let cosR = cos(rot);
    let sinR = sin(rot);
    screenPos = vec2f(
      screenPos.x * cosR - screenPos.y * sinR,
      screenPos.x * sinR + screenPos.y * cosR
    );
  }

  // Środek dziurki (0, 0 to środek ekranu)
  let center = vec2f(0.0, 0.0);
  let dist = distance(screenPos, center);

  // ───────────────────────────────────────────────────────────────
  // 2. DZIURKA OD KLUCZA / OKNO PODGLĄDU
  // ───────────────────────────────────────────────────────────────
  let holeRadius = 0.65;  // promień otworu
  let feather = 0.12;     // szerokość miękkiego przejścia (winieta)

  // Obliczamy widoczność maski zasłaniającej:
  // • Wewnątrz otworu (dist < holeRadius - feather) -> maskAlpha = 0.0 (przezroczyste: widać symulację!)
  // • Na zewnątrz otworu (dist > holeRadius + feather) -> maskAlpha = 1.0 (ciemna maska zakrywa tło)
  // • Pomiędzy -> gładkie przejście winiety
  let maskAlpha = smoothstep(holeRadius - feather, holeRadius + feather, dist);

  // Kolor tła maski poza otworem (ciemny grafit / głęboka czerń z odrobiną granatu)
  let maskBgColor = vec3f(0.02, 0.025, 0.04);

  // ───────────────────────────────────────────────────────────────
  // 3. ELEMENTY HUD RYSOWANE PRZED KAMERĄ
  // ───────────────────────────────────────────────────────────────
  // A) Świecący pierścień dookoła otworu
  let ring = smoothstep(0.015, 0.002, abs(dist - holeRadius));

  // B) Zewnętrzny subtelny pierścień technologiczny
  let outerRing = smoothstep(0.008, 0.002, abs(dist - (holeRadius + 0.08)));

  // C) Celownik HUD w centrum otworu
  let crossArmLen = 0.12;
  let crossThickness = 0.003;
  let crossX = smoothstep(crossThickness, 0.0, abs(screenPos.y)) * step(abs(screenPos.x), crossArmLen);
  let crossY = smoothstep(crossThickness, 0.0, abs(screenPos.x)) * step(abs(screenPos.y), crossArmLen);
  let crosshair = max(crossX, crossY);

  // D) Delikatne linie siatki celowniczej (znaczniki co kąt)
  let angle = atan2(screenPos.y, screenPos.x);
  let ticks = step(0.98, sin(angle * 12.0)) * step(holeRadius - 0.04, dist) * step(dist, holeRadius + 0.04);

  // ───────────────────────────────────────────────────────────────
  // 4. SKŁADANIE KOLORU I KANAŁU ALPHA
  // ───────────────────────────────────────────────────────────────
  // Neonowy błękitny akcent HUD
  let hudColor = vec3f(0.2, 0.85, 1.0);

  // Suma elementów HUD
  let hudElements = ring * 1.8 + outerRing * 0.6 + crosshair * 0.9 + ticks * 0.7;

  // Kolor RGB nakładki
  var finalRgb = maskBgColor;
  finalRgb += hudColor * hudElements;

  // KLUCZOWE: KANAŁ ALPHA
  // Dzięki trybowi blendowania 'src-alpha' + 'one-minus-src-alpha':
  // - Tam gdzie finalAlpha = 0.0 -> w 100% widać symulację w tle!
  // - Tam gdzie finalAlpha = 1.0 -> maska całkowicie zasłania tło.
  // - Elementy HUD dodają własną alfę, więc świecą nawet w przezroczystej części otworu!
  let finalAlpha = clamp(maskAlpha + hudElements, 0.0, 1.0);

  return vec4f(finalRgb, finalAlpha);
}


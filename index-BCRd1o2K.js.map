// ═══════════════════════════════════════════════════════════════════
// _wire.wgsl — Ciemny, lustrzany rdzeń miedziany i dyskretny ekran 3D
// ═══════════════════════════════════════════════════════════════════

struct Uniforms {
  mouse: vec4f,
  resolution: vec2f,
  time: f32,
  dt: f32,
  numPoints: u32,
  gravity: f32,
  damping: f32,
  interactionRadius: f32,
  vortexStrength: f32,
  pointSizeMultiplier: f32,
  interactionMode: f32,
  glowIntensity: f32,
  renderScale: f32,
  showOverlay: f32,
  pad0: f32,
  pad1: f32,
};

struct CameraUniforms {
  viewProj: mat4x4<f32>,
  invViewProj: mat4x4<f32>,
  eye: vec4f,
};

@group(0) @binding(0) var<uniform> U: Uniforms;
@group(1) @binding(0) var<uniform> camera: CameraUniforms;

const TAU: f32 = 6.2831853;
// Promień rysowania rdzenia mniejszy niż fizyczny WIRE_A (0.12),
// dzięki czemu cząstki poruszające się przy granicy okrążają go na wierzchu,
// tworząc wyraźną, spektakularną siatkę geometryczną wokół drutu.
const WIRE_DRAW_R: f32 = 0.088;
const X_HALF: f32 = 4.0;
const TUBE_SEGS: u32 = 36u;

struct VertexOutput {
  @builtin(position) clipPos: vec4f,
  @location(0) worldPos: vec3f,
  @location(1) normal: vec3f,
};

// ── Przewód centralny: szlachetny, ciemny, polerowany rdzeń miedziany ──
@vertex
fn vs_wire(@builtin(vertex_index) vIdx: u32) -> VertexOutput {
  var out: VertexOutput;

  let seg = vIdx / 6u;
  let corner = vIdx % 6u;
  let fSeg = f32(seg) / f32(TUBE_SEGS);
  let fSegNext = f32(seg + 1u) / f32(TUBE_SEGS);

  let ang0 = fSeg * TAU;
  let ang1 = fSegNext * TAU;

  var p: vec3f;
  var n: vec3f;

  if (corner == 0u) {
    p = vec3f(-X_HALF, WIRE_DRAW_R * cos(ang0), WIRE_DRAW_R * sin(ang0));
    n = vec3f(0.0, cos(ang0), sin(ang0));
  } else if (corner == 1u || corner == 3u) {
    p = vec3f(X_HALF, WIRE_DRAW_R * cos(ang0), WIRE_DRAW_R * sin(ang0));
    n = vec3f(0.0, cos(ang0), sin(ang0));
  } else if (corner == 2u || corner == 4u) {
    p = vec3f(-X_HALF, WIRE_DRAW_R * cos(ang1), WIRE_DRAW_R * sin(ang1));
    n = vec3f(0.0, cos(ang1), sin(ang1));
  } else {
    p = vec3f(X_HALF, WIRE_DRAW_R * cos(ang1), WIRE_DRAW_R * sin(ang1));
    n = vec3f(0.0, cos(ang1), sin(ang1));
  }

  out.clipPos = camera.viewProj * vec4f(p, 1.0);
  out.worldPos = p;
  out.normal = n;

  return out;
}

@fragment
fn fs_wire(in: VertexOutput) -> @location(0) vec4f {
  let viewDir = normalize(camera.eye.xyz - in.worldPos);
  let norm = normalize(in.normal);
  let ndotv = clamp(dot(norm, viewDir), 0.0, 1.0);

  // Światła kierunkowe dla metalicznego połysku lustrzanego
  let lightDir1 = normalize(vec3f(0.3, 0.85, 0.45));
  let lightDir2 = normalize(vec3f(-0.5, 0.4, -0.7));

  // Lustrzane refleksy (specular pow 36 dla efektu gładkiego, polerowanego metalu)
  let refl = reflect(-viewDir, norm);
  let spec1 = pow(max(dot(refl, lightDir1), 0.0), 36.0);
  let spec2 = pow(max(dot(refl, lightDir2), 0.0), 48.0);

  // Ciemna, szlachetna miedź (nieświecąca, by nie zagłuszać barwnych markerów)
  let copperBase = vec3f(0.22, 0.09, 0.04);
  let copperHighlight = vec3f(0.95, 0.65, 0.4);

  // Cieniowanie dyfuzyjne cylindra
  let diff = max(dot(norm, lightDir1), 0.0) * 0.4 + 0.22;

  // Metaliczny fresnel na krawędzi pręta
  let fresnel = pow(1.0 - ndotv, 3.2);

  var finalCol = copperBase * diff + copperHighlight * (spec1 * 0.75 - spec2 * 0.35) + vec3f(0.48, 0.22, 0.1) * fresnel * 0.35;

  return vec4f(finalCol, 0.95);
}

// ── Ekran zewnętrzny: subtelna holograficzna ramka pierścieni R ──
@vertex
fn vs_shield(@builtin(vertex_index) vIdx: u32, @builtin(instance_index) instIdx: u32) -> VertexOutput {
  var out: VertexOutput;

  let R = max(U.interactionRadius * 1.8, 0.48);
  let numRings = 7u;
  let ringX = mix(-X_HALF * 0.95, X_HALF * 0.95, f32(instIdx) / f32(numRings - 1u));

  let seg = vIdx / 6u;
  let corner = vIdx % 6u;
  let fSeg = f32(seg) / f32(TUBE_SEGS);
  let fSegNext = f32(seg + 1u) / f32(TUBE_SEGS);

  let ang0 = fSeg * TAU;
  let ang1 = fSegNext * TAU;
  let ringW = 0.015; // cieńszy pierścień

  var p: vec3f;
  if (corner == 0u) {
    p = vec3f(ringX - ringW, R * cos(ang0), R * sin(ang0));
  } else if (corner == 1u || corner == 3u) {
    p = vec3f(ringX + ringW, R * cos(ang0), R * sin(ang0));
  } else if (corner == 2u || corner == 4u) {
    p = vec3f(ringX - ringW, R * cos(ang1), R * sin(ang1));
  } else {
    p = vec3f(ringX + ringW, R * cos(ang1), R * sin(ang1));
  }

  out.clipPos = camera.viewProj * vec4f(p, 1.0);
  out.worldPos = p;
  out.normal = vec3f(0.0, cos(ang0), sin(ang0));

  return out;
}

@fragment
fn fs_shield(in: VertexOutput) -> @location(0) vec4f {
  let viewDir = normalize(camera.eye.xyz - in.worldPos);
  let norm = normalize(in.normal);
  let fresnel = (1.0 - abs(dot(norm, viewDir)), 3.0);

  // Bardzo dyskretny, ciemny błękit — ramka orientacyjna nieodciągająca uwagi
  let col = vec3f(0.2, 0.45, 0.75) * (0.2 + 0.6 * fresnel);
  return vec4f(col, 0.15 + 0.22 * fresnel);
}

// ═══════════════════════════════════════════════════════════════════
// compute.wgsl — Kaluza–Klein 5D: ładunki w polu przewodu z prądem
// 
// MODEL FIZYCZNY:
//  • Przewód wzdłuż osi X o promieniu a, w uziemionym ekranie o promieniu R.
//  • Dokładne rozwiązanie potencjału Laplace'a:
//        φ(x,r) = E0·(X_SHORT − x) · ln(R/r) / ln(R/a)
//  • B = K_B·I / r (azymutalne).
//  • Wektor Poyntinga S = E × B reprezentuje przepływ energii pola do drutu.
//  • Ruch 5D: p5 = q (ładunek elektryczny) generuje siłę Lorentza q(E + v×B).
//  • Integrator Borisa dla relatywistycznego ruchu cząstek.
// ═══════════════════════════════════════════════════════════════════

struct Uniforms {
  mouse: vec4f,            // 0..16: xyz = pozycja 3D sondy kursora, w = isMouseDown
  resolution: vec2f,       // 16..24: szerokość, wysokość
  time: f32,               // 24..28: czas symulacji
  dt: f32,                 // 28..32: delta time
  numPoints: u32,          // 32..36: liczba cząstek
  gravity: f32,            // 36..40: pole E0 / spadek napięcia osiowego
  damping: f32,            // 40..44: współczynnik próżni (1.0 = brak tarcia)
  interactionRadius: f32,  // 44..48: promień ekranu zewnętrznego R
  vortexStrength: f32,     // 48..52: prąd drutu I (pole magnetyczne)
  pointSizeMultiplier: f32,// 52..56: mnożnik rozmiaru
  interactionMode: f32,    // 56..60: tryb sondy (-Q, +Q, Bz)
  glowIntensity: f32,      // 60..64: poświata
  renderScale: f32,        // 64..68: DPR
  showOverlay: f32,        // 68..72: winieta HUD
  pad0: f32,               // 72..76
  pad1: f32,               // 76..80
};

struct Point {
  position: vec4f, // xyz, promień
  velocity: vec4f, // v (xyz), |v|
  color: vec4f,
  extra: vec4f,    // masa, ψ (5. wymiar), gęstość S, id
};

@group(0) @binding(0) var<uniform> U: Uniforms;
@group(0) @binding(1) var<storage, read> PT_in: array<Point>;
@group(0) @binding(2) var<storage, read_write> PT_out: array<Point>;

// ── Stałe modelu ───────────────────────────────────────────────────
const TAU: f32 = 6.2831853;
const WIRE_A: f32 = 0.12;       // promień przewodu
const X_HALF: f32 = 4.0;        // obszar symulacji: x ∈ [−X_HALF, X_HALF] (zawijany)
const X_SHORT: f32 = 4.4;       // zwarcie przewód–ekran (tu φ = 0)
const K_B: f32 = 0.8;           // μ0/2π w jednostkach symulacji
const C_LIGHT: f32 = 8.0;       // prędkość światła (maksymalna prędkość)
const OMEGA5: f32 = 1.5;        // skala ruchu wzdłuż 5. wymiaru
const TRACER_EVERY: u32 = 8u;   // co 8. cząstka = znacznik strumienia Poyntinga S
const PROBE_SOFT2: f32 = 0.04;  // zmiękczenie dla sondy myszy

struct Fields {
  E: vec3f,
  B: vec3f,
  A: vec3f,
  phi: f32,
};

// ── RNG (PCG hash) ─────────────────────────────────────────────────
fn pcg(v: u32) -> u32 {
  let state = v * 747796405u + 2891336453u;
  let word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

fn rnd(seed: ptr<function, u32>) -> f32 {
  *seed = pcg(*seed);
  return f32(*seed) / 4294967295.0;
}

fn shieldRadius() -> f32 {
  return max(U.interactionRadius * 1.8, WIRE_A * 4.0);
}

// ── Pole przewodu w ekranie (dokładne rozwiązanie Laplace'a) ────────
fn wireFields(pos: vec3f) -> Fields {
  let R = shieldRadius();
  let E0 = U.gravity * 0.5;
  let I = U.vortexStrength;
  let rr = length(pos.yz);
  let r = max(rr, 1e-4);
  let rHat = vec3f(0.0, pos.y, pos.z) / r;
  let phiHat = vec3f(0.0, -pos.z, pos.y) / r; // r̂ × φ̂ = x̂
  let lnRa = log(R / WIRE_A);
  let V = E0 * (X_SHORT - pos.x);

  var f: Fields;
  if (rr < WIRE_A) {
    // wnętrze przewodu: jednorodne E wzdłuż osi, B rośnie liniowo z r
    f.phi = V;
    f.E = vec3f(E0, 0.0, 0.0);
    f.B = phiHat * (K_B * I * r / (WIRE_A * WIRE_A));
    f.A = vec3f(-0.5 * K_B * I * (r * r / (WIRE_A * WIRE_A) - 1.0), 0.0, 0.0);
  } else {
    let rc = min(r, R);
    let g = log(R / rc) / lnRa;
    f.phi = V * g;
    f.E = vec3f(E0 * g, 0.0, 0.0) + rHat * (V / (rc * lnRa));
    f.B = phiHat * (K_B * I / rc);
    f.A = vec3f(-K_B * I * log(rc / WIRE_A), 0.0, 0.0);
  }
  return f;
}

// ── Sonda myszy / dotyku w przestrzeni 3D ───────────────────────────
fn addProbe(pos: vec3f, fIn: Fields) -> Fields {
  var f = fIn;
  if (U.mouse.w < 0.5) { return f; }

  let m = U.mouse.xyz;
  let d = pos - m;
  let d2 = dot(d, d) + PROBE_SOFT2;
  let invD = inverseSqrt(d2);
  let invD3 = invD / d2;

  if (U.interactionMode < 1.5) {
    // tryb 0: ładunek ujemny (-Q), tryb 1: dodatni (+Q)
    let Q = select(-2.0, 2.0, U.interactionMode > 0.5);
    f.E += Q * d * invD3;
    f.phi += Q * invD;
  } else {
    // tryb 2: dipol magnetyczny wzdłuż osi Z
    let mm = vec3f(0.0, 0.0, 2.5 * max(U.vortexStrength, 0.2));
    f.B += K_B * (3.0 * d * dot(mm, d) / d2 - mm) * invD3;
    f.A += K_B * cross(mm, d) * invD3;
  }
  return f;
}

@compute @workgroup_size(64, 1, 1)
fn cs_main(@builtin(global_invocation_id) id: vec3u) {
  let index = id.x;
  if (index >= U.numPoints) { return; }

  var p = PT_in[index];
  var pos = p.position.xyz;
  var vel = p.velocity.xyz;
  let size = p.position.w;
  let mass = max(p.extra.x, 0.1);
  var psi = p.extra.y; // faza 5. wymiaru

  let dt = clamp(U.dt, 0.0, 1.0 / 30.0);
  let R = shieldRadius();
  let isTracer = (index % TRACER_EVERY) == 0u;
  let q = select(-1.0, 1.0, (pcg(index) & 1u) == 1u);

  // --- 1. POLA w aktualnej pozycji ---
  let f = addProbe(pos, wireFields(pos));

  // --- 2. WEKTOR POYNTINGA S = E × B ---
  let S = cross(f.E, f.B);
  let sLen = length(S);

  if (isTracer) {
    // --- 3a. ZNACZNIK ENERGII: płynie wzdłuż linii wektora Poyntinga ---
    let dir = select(vec3f(1.0, 0.0, 0.0), S / max(sLen, 1e-6), sLen > 1e-6);
    vel = dir * (0.4 + 2.4 * tanh(sLen * 1.5));
    pos += vel * dt;

    // Odnowienie znacznika po opuszczeniu obszaru lub wpadnięciu do drutu
    let rNow = length(pos.yz);
    if (rNow < WIRE_A || rNow > R || abs(pos.x) > X_HALF) {
      var seed = pcg(index) ^ u32(U.time * 1000.0);
      let rNew = sqrt(mix(WIRE_A * WIRE_A * 1.05, R * R * 0.98, rnd(&seed)));
      let ang = rnd(&seed) * TAU;
      pos = vec3f((rnd(&seed) * 2.0 - 1.0) * X_HALF, rNew * cos(ang), rNew * sin(ang));
    }
  } else {
    // --- 3b. ŁADUNEK: relatywistyczny integrator Borisa (u = γv) ---
    let qm = q / mass;
    let c2 = C_LIGHT * C_LIGHT;
    let v2 = min(dot(vel, vel), c2 * 0.999);
    var u = vel / sqrt(1.0 - v2 / c2);

    let h = 0.5 * qm * dt;
    let uMinus = u + h * f.E;
    let gMinus = sqrt(1.0 + dot(uMinus, uMinus) / c2);
    let t = (h / gMinus) * f.B;
    let s = 2.0 * t / (1.0 + dot(t, t));
    let uPrime = uMinus + cross(uMinus, t);
    let uPlus = uMinus + cross(uPrime, s);
    u = uPlus + h * f.E;

    // Opór ośrodka (damping = 1.0 → próżnia bez tarcia)
    let nu = (1.0 - clamp(U.damping, 0.0, 1.0)) * 6.0;
    u *= exp(-nu * dt);

    let gamma = sqrt(1.0 + dot(u, u) / c2);
    vel = u / gamma;
    pos += vel * dt;

    // --- 4. 5. WYMIAR: zachowanie pędu p5 = q ⇒ ψ̇ = q/m·Ω5 − (A·v − φ) ---
    psi += (qm * OMEGA5 - (dot(f.A, vel) - f.phi)) * dt;

    // --- 5. BRZEGI: stabilne sprężyste odbicie (brak przywierania do ścian) ---
    let rNow = length(pos.yz);
    if (rNow < WIRE_A) {
      let n = select(vec3f(0.0, 1.0, 0.0), vec3f(0.0, pos.y, pos.z) / rNow, rNow > 1e-4);
      let rIn = WIRE_A * 1.002;
      pos = vec3f(pos.x, n.yz * rIn);
      if (dot(vel, n) < 0.0) {
        vel -= 2.0 * dot(vel, n) * n;
      }
    } else if (rNow > R) {
      let n = select(vec3f(0.0, 1.0, 0.0), vec3f(0.0, pos.y, pos.z) / rNow, rNow > 1e-4);
      let rIn = R * 0.998;
      pos = vec3f(pos.x, n.yz * rIn);
      if (dot(vel, n) > 0.0) {
        vel -= 2.0 * dot(vel, n) * n;
      }
    }

    // Periodyczne zawijanie wzdłuż osi X
    if (pos.x > X_HALF) { pos.x -= 2.0 * X_HALF; }
    if (pos.x < -X_HALF) { pos.x += 2.0 * X_HALF; }
  }

  psi = psi - TAU * floor(psi / TAU);

  // --- 6. KOLOR: Fizyczny podział cząstek + natężenie pola Poyntinga ---
  let fieldStrength = 1.0 - exp(-sLen * 0.8);
  let kk = 0.5 + 0.5 * cos(psi);
  var finalRgb: vec3f;
  if (isTracer) {
    // Wektor Poyntinga S (energia pola) -> elektryczny błękit / cyjan
    finalRgb = mix(vec3f(0.12, 0.42, 1.0), vec3f(0.42, 0.9, 1.0), fieldStrength);
  } else if (q > 0.0) {
    // Ładunki dodatnie -> płomień / słoneczny pomarańcz
    finalRgb = mix(vec3f(1.0, 0.38, 0.06), vec3f(1.0, 0.7, 0.22), kk);
  } else {
    // Ładunki ujemne -> neonowy fiolet / magenta
    finalRgb = mix(vec3f(0.48, 0.12, 0.98), vec3f(0.88, 0.28, 0.8), kk);
  }
  let brightness = clamp(0.55 + 0.45 * fieldStrength * U.glowIntensity, 0.2, 2.0);

  p.position = vec4f(pos, size);
  p.velocity = vec4f(vel, length(vel));
  p.color = vec4f(finalRgb * brightness, 1.0);
  p.extra = vec4f(mass, psi, fieldStrength, f32(index));

  PT_out[index] = p;
}
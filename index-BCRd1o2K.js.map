// ═══════════════════════════════════════════════════════════════════
//  render.wgsl — Optymalny Render Pipeline: Instanced Quads & Billboards
// ═══════════════════════════════════════════════════════════════════

struct Uniforms {
  mouse: vec4f,              // 0..16
  resolution: vec2f,         // 16..24
  time: f32,                 // 24..28
  dt: f32,                   // 28..32
  numPoints: u32,            // 32..36
  gravity: f32,              // 36..40
  damping: f32,              // 40..44
  interactionRadius: f32,    // 44..48
  vortexStrength: f32,       // 48..52
  pointSizeMultiplier: f32,  // 52..56
  interactionMode: f32,      // 56..60
  glowIntensity: f32,        // 60..64
  renderScale: f32,          // 64..68
  showOverlay: f32,          // 68..72
  pad0: f32,                 // 72..76
  pad1: f32,                 // 76..80
};

struct Point {
  position: vec4f,           // xyz = pozycja 3D, w = promień bazowy
  velocity: vec4f,           // xyz = prędkość 3D, w = szybkość
  color: vec4f,              // rgba = kolor
  extra: vec4f,              // masa, faza, gęstość, id
};

struct CameraUniforms {
  viewProj: mat4x4<f32>,     // Macierz widoku i rzutowania (View-Projection)
  invViewProj: mat4x4<f32>,  // Macierz odwrotna
  eye: vec4f,                // Pozycja oka kamery (xyz)
};

// -------------------------------------------------------------------
// Bindings
// -------------------------------------------------------------------
@group(0) @binding(0) var<uniform> U: Uniforms;
@group(0) @binding(1) var<storage, read> PT: array<Point>;

@group(1) @binding(0) var<uniform> camera: CameraUniforms;

// -------------------------------------------------------------------
// Stałe efektu: głębia ostrości (DOF) + smuga ruchu + płomień palnika
// -------------------------------------------------------------------
const VISIBLE_FRAC: f32 = 0.2;    // dawny próg `dist > 0.2` → widoczny promień = 0.2 · radius
const FOCUS_STRENGTH: f32 = 1.8;  // jak szybko rośnie rozmycie poza płaszczyzną ostrości
const BLUR_GROW: f32 = 5.0;       // maks. powiększenie plamki rozmycia (krążek nieostrości)
const SHUTTER: f32 = 0.02;        // "czas naświetlania" → długość smugi = |v_ekran| · SHUTTER
const MAX_STREAK: f32 = 22.0;     // limit długości ogona (w promieniach plamki)
const C_LIGHT: f32 = 8.0;         // = C_LIGHT z compute.wgsl (normalizacja prędkości)

// -------------------------------------------------------------------
// Wyjście z Vertex Shadera
// -------------------------------------------------------------------
struct VertexOutput {
  @builtin(position) clipPos: vec4f,
  @location(0) uv: vec2f,         // x: wzdłuż ruchu (głowa = 0, ogon < 0), y: w poprzek
  @location(1) color: vec4f,
  @location(2) speed: f32,
  @location(3) camPos: vec3f,
  // x = długość ogona s (w promieniach), y = rozmycie 0..1, z = |v|/c, w = ziarno migotania
  // (bez @interpolate(flat) — w trybie compat na telefonach samo `flat` jest niedozwolone;
  //  wartość jest stała na całym quadzie, więc interpolacja i tak jej nie zmienia)
  @location(4) fx: vec4f,
};

// ═══════════════════════════════════════════════════════════════════
// VERTEX SHADER — Instancjonowane Quady 3D z billboardem
// ═══════════════════════════════════════════════════════════════════
@vertex
fn vs_main(
  @builtin(vertex_index) vertexIndex: u32,
  @builtin(instance_index) instanceIndex: u32,
) -> VertexOutput {
  var out: VertexOutput;

  // Współrzędne 6 wierzchołków jednostkowego quada [-1, 1]
  var quadCorners = array<vec2f, 6>(
    vec2f(-1.0, -1.0),
    vec2f( 1.0, -1.0),
    vec2f(-1.0,  1.0),
    vec2f(-1.0,  1.0),
    vec2f( 1.0, -1.0),
    vec2f( 1.0,  1.0)
  );

  let corner = quadCorners[vertexIndex];
  let p = PT[instanceIndex];
  let worldPos = p.position.xyz;
  let radius = max(0.04, p.position.w * U.pointSizeMultiplier);
  let baseR = radius * VISIBLE_FRAC;

  // Billboarding w 3D: orientujemy quad zawsze prostopadle do wektora patrzenia kamery
  let camRight = normalize(vec3f(camera.viewProj[0].x, camera.viewProj[1].x, camera.viewProj[2].x));
  let camUp = normalize(vec3f(camera.viewProj[0].y, camera.viewProj[1].y, camera.viewProj[2].y));

  // --- GŁĘBIA OSTROŚCI (soczewka cienka) ---
  // Płaszczyzna ostrości przechodzi przez centrum sceny 3D (0,0,0).
  // clip.w = głębokość w przestrzeni widoku, CoC ∝ |z − z_f| / z
  let depth = max((camera.viewProj * vec4f(worldPos, 1.0)).w, 1e-3);
  let focusDepth = max((camera.viewProj * vec4f(0.0, 0.0, 0.0, 1.0)).w, 1e-3);
  let blur = clamp(abs(depth - focusDepth) / depth * FOCUS_STRENGTH, 0.0, 1.0);
  let halfW = baseR * (1.0 + blur * BLUR_GROW); // plamka rośnie wraz z nieostrością

  // --- SMUGA RUCHU: rzut prędkości na płaszczyznę ekranu ---
  let vel = p.velocity.xyz;
  let vScr = vec2f(dot(vel, camRight), dot(vel, camUp));
  let vLen = length(vScr);
  let dir2 = select(vec2f(1.0, 0.0), vScr / max(vLen, 1e-6), vLen > 1e-5);
  // rozmyte cząstki "rozciągają się" mocniej → przechodzą w język płomienia
  let streak = vLen * SHUTTER * (1.0 + blur * 1.5);
  let s = min(streak / halfW, MAX_STREAK);

  // Quad: od końca ogona (−1−s) do czoła (+1) wzdłuż kierunku ruchu
  let lx = mix(-1.0 - s, 1.0, corner.x * 0.5 + 0.5);
  let ly = corner.y;
  let dirW = camRight * dir2.x + camUp * dir2.y;
  let perpW = camRight * (-dir2.y) + camUp * dir2.x;
  let billboardPos = worldPos + (dirW * lx + perpW * ly) * halfW;

  // Przekształcenie do Clip Space
  out.clipPos = camera.viewProj * vec4f(billboardPos, 1.0);
  out.uv = vec2f(lx, ly);
  out.camPos =  camera.eye.xyz;
  out.color = p.color;
  out.speed = p.velocity.w;
  out.fx = vec4f(s, blur, clamp(p.velocity.w / C_LIGHT, 0.0, 1.0), fract(p.extra.w * 0.61803398875));

  return out;
}

// -------------------------------------------------------------------
// Gradient płomienia palnika: gorący rdzeń → pomarańcz → fiolet
// t = 0 gorąco (u nasady), t = 1 chłodno (końcówka języka / brzeg)
// -------------------------------------------------------------------
fn flameColor(t: f32) -> vec3f {
  let hot    = vec3f(1.0, 0.82, 0.5);
  let orange = vec3f(1.0, 0.42, 0.07);
  let violet = vec3f(0.55, 0.12, 0.95);
  var c = mix(hot, orange, smoothstep(0.0, 0.4, t));
  c = mix(c, violet, smoothstep(0.35, 1.0, t));
  return c;
}

// ═══════════════════════════════════════════════════════════════════
// FRAGMENT SHADER — Świetlisty punkt z antyaliasingiem i miękką poświatą
// ═══════════════════════════════════════════════════════════════════
@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4f {
  let s = in.fx.x;
  let blur = in.fx.y;
  let speedN = in.fx.z;
  let seed = in.fx.w;

  // Odległość od odcinka [−s, 0] → kształt kapsuły (kropka + ogon smugi)
  let ax = in.uv.x - clamp(in.uv.x, -s, 0.0);
  let dist = length(vec2f(ax, in.uv.y));
  if (dist > 1.0) {
    discard;
  }
  // 0 = czoło cząstki, 1 = koniec ogona
  let tail = select(0.0, clamp(-in.uv.x / max(s, 1e-3), 0.0, 1.0), s > 1e-3);

  // Kolor z compute shadera: ładunek ±, faza 5D (ψ), znaczniki S

  // efect ostrosci w centrum 3d i delikatne rozmywanie w coraz delikatnie wiekszej skali  z przezroczystoscia ktora rosnie z dystansem ale w 1/x proporcji:
  //  → realizacja: `blur` (CoC) liczony w vs_main; plamka rośnie ×(1 + blur·BLUR_GROW),
  //    a przezroczystość rośnie jak 1/x: alpha ∝ 1 / grow.
  let grow = 1.0 + blur * BLUR_GROW;
  let fade = 1.0 / grow;

  // w kodzie rn to teraz jest tylko indeks do zinterpretowania przez to co ponizej:
  // teraz bedzie robiony efekt w ktorym czastki beda sie robic coraz mniejsze w miare oddalania sie od srodka:  
  //  → realizacja: ostry rdzeń zajmuje tylko 1/grow plamki, więc kurczy się poza ostrością,
  //    a reszta energii rozlewa się w miękki płomień.
  let rn = dist * grow; // 0 = środek, 1 = krawędź ostrego rdzenia

  let core = exp(-rn * rn * 6.0);
  let halo = (1.0 - smoothstep(0.0, 1.0, rn)) * 0.35 * U.glowIntensity;
  var soft = 1.0 - smoothstep(0.0, 1.0, dist);
  soft = soft * soft;

  // --- PRĘDKOŚĆ → JASNOŚĆ (i temperatura płomienia) ---
  let speedBoost = 0.55 + 2.0 * pow(max(speedN, 1e-4), 0.7);

  // --- OSTRA CZĄSTKA: kolor "teoretyczny" z compute (niebieski znacznik S / ładunki) ---
  let sharpRgb = in.color.rgb * (core * 1.4 + halo) + vec3f(core * core * (0.2 + 0.5 * speedN));

  // --- PŁOMIEŃ: rozmycie + ruch odbierają cząstce tożsamość ---
  let flick = 0.85 + 0.15 * sin(U.time * 23.0 + seed * 40.0 + tail * 9.0);
  let flameT = clamp(0.45 * dist + 0.65 * tail + 0.3 * blur - 0.35 * speedN, 0.0, 1.0);
  let flameRgb = flameColor(flameT) * soft * 1.2 * flick;

  // im bardziej nieostra i im dalej w ogonie, tym mniej "cząstki", a więcej płomienia
  let flameMix = clamp(blur * 1.4 + tail * 0.9, 0.0, 1.0);
  let tailFade = pow(max(1.0 - tail, 1e-4), 1.6);

  // Umiarkowana przezroczystość dla additive blend, by cząstki nie przepalały się na czystą biel
  let finalRgb = mix(sharpRgb, flameRgb, flameMix) * speedBoost * tailFade;
  let finalAlpha = clamp(mix(core + halo, soft, flameMix) * fade * tailFade, 0.0, 1.0);

  return vec4f(finalRgb, finalAlpha);
}
